# Normalize line endings: let git handle conversion, store LF in the repo.
* text=auto eol=lf

# Windows-specific scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.iss text eol=crlf

# Treat these as binary (never convert).
*.png binary
*.ico binary
*.wav binary
*.mp3 binary
*.th binary
*.pt binary
